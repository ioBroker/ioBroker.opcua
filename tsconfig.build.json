{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "checkJs": false,
        "noEmit": false,
        "declaration": false,
        "outDir": "./build",
        "rootDir": "./src",
        "types": ["@iobroker/types", "node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["build/**", "node_modules/**", "src-admin/**", "admin/**"]
}
