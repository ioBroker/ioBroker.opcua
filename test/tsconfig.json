{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noImplicitAny": false,
        // the tests are plain JavaScript, the root tsconfig compiles TypeScript only
        "allowJs": true,
        "checkJs": true,
        // the tests are outside of the "src" directory of the adapter
        "rootDir": "..",
        "types": ["@iobroker/types", "node", "mocha"]
    },
    "include": ["./**/*.js"]
}
